{
  "appId": "com.syd-sbn.voidspheres",
  "appName": "Speedy jumper",
  "webDir": "dist",
  "server": {
    "iosScheme": "voidspheres"
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#02050d",
      "showSpinner": false
    }
  }
}
